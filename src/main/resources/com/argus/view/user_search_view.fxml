<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<VBox fx:id="rootContainer" alignment="CENTER" spacing="12.0" styleClass="root-container"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.argus.controller.UserSearchController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <Label text="Argus Family Library Manager" styleClass="title-label"/>
        <javafx.scene.layout.Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="themeToggleButton" text="Tema scuro" onAction="#handleToggleThemeAction"/>
    </HBox>
    <Label text="Inserisci i link o gli ID Steam dei membri della famiglia:"/>

    <!-- Contenitore dinamico per i campi di testo dei link -->
    <ScrollPane fitToWidth="true" prefHeight="125.0" prefWidth="560.0">
        <content>
            <VBox fx:id="inputFieldsContainer" spacing="10.0">
                <padding>
                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                </padding>
            </VBox>
        </content>
    </ScrollPane>

    <Button text="Carica Libreria Famiglia" onAction="#handleSearchAction" defaultButton="true" styleClass="search-button"/>

    <Label fx:id="statusLabel" text="${controller.statusMessage}" styleClass="status-label"/>

    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-bar">
        <Label text="Utente:"/>
        <ComboBox fx:id="ownerFilter" prefWidth="180.0"/>
        <CheckBox fx:id="playedOnlyFilter" text="Solo con ore giocate"/>
        <TextField fx:id="gameSearchField" promptText="Cerca gioco..." HBox.hgrow="ALWAYS"/>
    </HBox>

    <ScrollPane fx:id="gamesScrollPane" fitToWidth="true" prefHeight="350.0" prefWidth="950.0">
        <content>
            <GridPane fx:id="gamesGrid" hgap="10.0" vgap="10.0">
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                </padding>
            </GridPane>
        </content>
    </ScrollPane>
    <VBox fx:id="gameDetailsPanel" spacing="6.0" maxWidth="950.0" styleClass="game-details"/>
</VBox>